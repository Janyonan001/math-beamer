%% =====================================================================
%%  mybeamer0t.sty  ——  极简个人版 + 居中窄标题块（"t" = title）
%%  依赖：xelatex + ctexbeamer + 思源宋体/黑体
%%  用法：\documentclass[10pt,aspectratio=169,t]{ctexbeamer}
%%        \usepackage{mybeamer0t}
%%  说明：与 mybeamer0.sty 内容完全相同，唯一区别是标题页默认改成
%%        "0.75 倍正文宽、圆角、带阴影、水平居中的红色标题块"。
%%        想改宽度/内边距/圆角，直接改第 9b 节里的数字即可。
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mybeamer0t}[2026/11/25 v0.1 minimal theme + centered title block]

\mode<presentation>

% 1. 依赖
\RequirePackage{xcolor}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{ragged2e}      % \justifying 两端对齐
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,calc}

% 2. 主题骨架
\useoutertheme[subsection=false]{smoothbars}   % 顶部章节导航条
\usefonttheme[stillsansseriflarge]{serif}
\useinnertheme{circles}
\usecolortheme{spruce}

% 3. 中文字体
\ifdefined\setCJKmainfont
  \setCJKmainfont{Source Han Serif SC}[BoldFont={Source Han Serif SC Bold}]
  \setCJKsansfont{Source Han Sans SC}[BoldFont={Source Han Sans SC Bold}]
\fi

% 4. 调色板（屏幕用 RGB，数值是原 CMYK 定义的实测渲染值）
\definecolor{xyyg}{RGB}{146,15,20}          % 主色：导航条、标题条、页脚、块标题
\definecolor{xyyg_orange}{RGB}{242,92,25}   % 页脚中段混色用
\definecolor{xyyg_gold}{RGB}{238,159,60}
\definecolor{xyyg_blue}{RGB}{71,92,135}
\definecolor{xyyg_darkblue}{RGB}{14,52,99}
\definecolor{xyyg_gray}{RGB}{134,131,122}
\definecolor{xyyg_dirt}{RGB}{186,149,112}
\definecolor{xyyg_green}{RGB}{177,196,14}
\definecolor{xyyg_darkgreen}{RGB}{69,71,27}
\definecolor{WM_Gold}{RGB}{181,138,67}
\definecolor{accent}{RGB}{196,60,50}        % 强调色：\alert、alert 块
\definecolor{dotpink}{RGB}{214,60,120}

% 5. 配色绑定
\setbeamercolor{structure}{fg=xyyg}
\setbeamercolor{frametitle}{bg=white,fg=xyyg}
\setbeamercolor{title}{bg=xyyg,fg=white}
\setbeamercolor{section in head/foot}{bg=xyyg,fg=white}
\setbeamercolor{section in head/foot shaded}{bg=xyyg,fg=white!55!xyyg}
\setbeamercolor{alerted text}{fg=accent}
\setbeamercolor{footleft}{bg=xyyg,fg=white}
\setbeamercolor{footmid}{bg=xyyg!60!xyyg_orange,fg=white}
\setbeamercolor{footright}{bg=xyyg,fg=white}
\setbeamercolor{block title}{bg=xyyg,fg=white}
\setbeamercolor{block body}{bg=xyyg!10,fg=black}
\setbeamercolor{block title alerted}{bg=accent,fg=white}
\setbeamercolor{block body alerted}{bg=accent!10,fg=black}

% 6. 排版参数
\linespread{1.2}
\hypersetup{hidelinks,bookmarksnumbered}
\renewcommand{\raggedright}{\justifying}   % 正文两端对齐
\setbeamertemplate{caption}[numbered]
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}
\setbeamertemplate{theorems}[numbered]
\setbeamertemplate{itemize items}[ball]
\setbeamertemplate{enumerate items}[default]

% 7. 页脚：左 30% 作者 | 中 45% 短标题 | 右 25% 页码，三处都居中、\small 字号
\setbeamerfont{author in head/foot}{size=\small}
\setbeamerfont{title in head/foot}{size=\small}
\setbeamerfont{frame number}{size=\small}
\def\mb@pageinfo{%
  \ifnum\value{framenumber}=1 \else \insertframenumber\,/\,\inserttotalframenumber\fi}
\setbeamertemplate{footline}{%
  \leavevmode
  \hbox to\paperwidth{%
    \begin{beamercolorbox}[wd=0.30\paperwidth,ht=16pt,dp=0pt,vmode]{footleft}%
      \vbox to 16pt{\vfil
        \hbox to\hsize{\hss\usebeamerfont{author in head/foot}\insertshortauthor\hss}%
      \vfil}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=0.45\paperwidth,ht=16pt,dp=0pt,vmode]{footmid}%
      \vbox to 16pt{\vfil
        \hbox to\hsize{\hss\usebeamerfont{title in head/foot}\insertshorttitle\hss}%
      \vfil}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=0.25\paperwidth,ht=16pt,dp=0pt,vmode]{footright}%
      \vbox to 16pt{\vfil
        \hbox to\hsize{\hss\usebeamerfont{frame number}\mb@pageinfo\hss}%
      \vfil}%
    \end{beamercolorbox}%
    \hss
  }%
}

% 8. 页眉：定高章节导航条
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,colsep=0pt,ht=11.6pt,dp=0.5ex,
                        vmode]{section in head/foot}%
    \vbox to 11.6pt{\vskip0.5pt\insertnavigation{\paperwidth}\vss}%
  \end{beamercolorbox}%
}

% 9. 帧标题：白底、主色字、定高（正文起始位置不抖）
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \usebeamerfont*{frametitle}%
  \begin{beamercolorbox}[wd=\paperwidth,sep=0ex,ht=1em,dp=2pt,
                        leftskip=0.5em,rightskip=2em]{frametitle}%
    \strut\insertframetitle
  \end{beamercolorbox}%
}

% 9b. 标题页：0.75 倍正文宽、圆角、带阴影、水平居中的红色标题块
%     必须用 \centerline 包住：色块是定宽 \hbox，在垂直模式下
%     \centering 与两侧 \hfill 都不生效，只有 \centerline
%     （内部等价于 \hbox to\hsize{\hss…\hss}）才居得中。
%     wd 改宽度（0.66/0.8 都行）、sep 改内边距（8~14pt）、
%     去掉 rounded=true,shadow=true 就是直角无边块。
\setbeamertemplate{title}{%
  \centerline{%
    \begin{beamercolorbox}[wd=0.75\textwidth,sep=14pt,center,rounded=true,shadow=true]{title}%
      {\usebeamerfont{title}\inserttitle\par}%
      \ifx\insertsubtitle\empty\else
        \vskip0.25em{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
      \fi
    \end{beamercolorbox}}}

% 10. 右下角导航箭头：◀◀ 上一节 | ◀ 上一页 ▶ 下一页 | ▶▶ 下一节 | 首页
\newcommand{\mb@navL}{\scalebox{2.3}{$\blacktriangleleft$}}
\newcommand{\mb@navR}{\scalebox{2.3}{$\blacktriangleright$}}
\newcommand{\mb@navbtn}[1]{\mbox{\hspace{1.2pt}#1\hspace{1.2pt}}}
\setbeamertemplate{navigation symbols}{%
  \hbox{%
    \color{xyyg}%
    \hyperlinksectionendprev{\mb@navbtn{\mb@navL\mb@navL}}%
    \hskip0.35em\textcolor{xyyg!45}{\rule[-2pt]{0.4pt}{9pt}}\hskip0.35em
    \hyperlinkslideprev{\mb@navbtn{\mb@navL}}%
    \hskip0.25em
    \hyperlinkslidenext{\mb@navbtn{\mb@navR}}%
    \hskip0.35em\textcolor{xyyg!45}{\rule[-2pt]{0.4pt}{9pt}}\hskip0.35em
    \hyperlinksectionstartnext{\mb@navbtn{\mb@navR\mb@navR}}%
    \hskip0.4em\textcolor{xyyg!45}{\rule[-2pt]{0.4pt}{9pt}}\hskip0.4em
    \hyperlinkpresentationstart{\mb@navbtn{\small 首页}}%
  }%
}

\mode<all>
\endinput
