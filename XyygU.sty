\beamertemplateshadingbackground{white!5}{white}% 页面背景从上到下渐变：5%灰色 → 纯白

\setbeamercolor{palette primary}{use=structure,fg=white,bg=structure.fg}% 主调色板（当前section、标题等）：白字校红底
\setbeamercolor{palette secondary}{use=structure,fg=white,bg=structure.fg!95!black}%{use=structure,fg=white,bg=structure.fg!90!black} 次调色板：95%校红+5%黑（更深一点）
\setbeamercolor{palette tertiary}{use=structure,fg=white,bg=structure.fg!90!black}% 第三调色板：90%校红+10%黑
\setbeamercolor{palette quaternary}{fg=white,bg=structure.fg!85!black}% 第四调色板：85%校红+15%黑
%\setbeamercolor*{sidebar}{use=structure,bg=structure.fg}
\setbeamercolor{titlelike}{parent=palette primary}% 所有标题类元素继承palette primary的颜色
%\setbeamercolor{structure}{fg=xyyg}% 所有结构元素（项目符号、线段、图标等）的前景色设为校红色

%% try
\setbeamercolor{block title}{bg=xyyg_blue,fg=white}% 普通block标题：蓝底白字
\setbeamercolor{block body}{bg=xyyg_blue!10}% 普通block正文：10%浅蓝背景

\BeforeBeginEnvironment{definition}{%
    \setbeamercolor{block title}{bg=xyyg_blue,fg=white}% definition环境开始前，强制设置为蓝色块
    \setbeamercolor{block body}{bg=xyyg_blue!10}
}
\AfterEndEnvironment{definition}{
 \setbeamercolor{block title}{bg=xyyg_blue,fg=white}% definition环境结束后，恢复为蓝色块
 \setbeamercolor{block body}{bg=xyyg_blue!10}
}

\BeforeBeginEnvironment{theorem}{%
    \setbeamercolor{block title}{bg=xyyg_orange,fg=white}% theorem环境开始前，设置为橙色块
    \setbeamercolor{block body}{bg=xyyg_orange!10}
}
\AfterEndEnvironment{theorem}{
 \setbeamercolor{block title}{bg=xyyg_blue,fg=white}
 \setbeamercolor{block body}{bg=xyyg_blue!10}
}

\BeforeBeginEnvironment{proposition}{% 命题也用橙色块
    \setbeamercolor{block title}{bg=xyyg_orange,fg=white}
    \setbeamercolor{block body}{bg=xyyg_orange!10}
}
\AfterEndEnvironment{proposition}{
 \setbeamercolor{block title}{bg=xyyg_blue,fg=white}
 \setbeamercolor{block body}{bg=xyyg_blue!10}
}

\setbeamercolor*{block title example}{use={normal text,example text},bg=white!70!pantone_gold,fg=xyyg}% example环境的标题：70%白+30%金色背景，校红色文字
