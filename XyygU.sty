\mode<presentation> %只在演示模式（即生成PDF时）生效，在article模式下不加载这些设置

\newif\ifbeamer@secheader %定义一个条件开关，控制是否在每个section前显示标题头
\beamer@secheaderfalse %默认关闭该开关

\ProcessOptionsBeamer

\useoutertheme[subsection=false]{smoothbars} %使用 smoothbars 外部主题，顶部有彩色导航条，显示当前section和subsection；subsection=false 表示不显示subsection级别的导航
\makeatletter
\newcommand{\frameofframes}{/} %定义帧号分隔符，默认显示为 "3 / 15" 中的 "/"
\newcommand{\setframeofframes}[1]{\renewcommand{\frameofframes}{#1}} %许用户自定义分隔符，比如改成 "·" 或 "of"
\setbeamertemplate{footline} 
  {%
    \begin{beamercolorbox}[colsep=1.5pt]{upper separation line foot}
    \end{beamercolorbox} %页脚上方的分隔线（1.5pt间距）
    \begin{beamercolorbox}[ht=2.5ex,dp=1ex,%页脚高度和深度
      leftskip=.3cm,rightskip=.3cm plus1fil]{author in head/foot}%左边距，右边距，允许弹性拉伸
      {\usebeamerfont{author in head/foot}\insertshortauthor}% 显示短作者名
      \hfill%
      {\usebeamerfont{title in head/foot}\insertshorttitle}% 显示短标题
      \hfill%
      {\usebeamerfont{frame number}\usebeamercolor[fg]{frame number}\insertframenumber~\frameofframes~\inserttotalframenumber} % 当前帧号 / 总帧号
    \end{beamercolorbox}%
    \begin{beamercolorbox}[colsep=1.5pt]{lower separation line foot}
    \end{beamercolorbox}% 页脚下方的分隔线
  }
\makeatother

\useinnertheme{circles}% 使用圆形项目符号主题，itemize的每个条目前面显示小圆点
%\useinnertheme{rectangles} 方形项目符号
%\useoutertheme{default}
%\useinnertheme[shadow=true]{rounded}

%section in head/foot 是 Beamer 预定义的颜色主题名称，通常用于控制页眉或页脚的背景色和文字颜色。

% ---- 固定高度顶栏（对 smoothbars 的修补）----
% 仅做三件事：① 去掉原版顶栏/标题条之间的模糊渐变过渡；② 固定条带高度（原版无标题的
% 分节目录页会比正文页高一截）；③ 配色统一为 xyyg。导航条内部几何（文字/圆点行位置、
% 0.3cm 内边距、字号）完全保留原版：条带高度 = 原版 barshade 的 6ex（同样在
% \AtBeginDocument 的 headline 字体上下文中求值），导航行经像素校准锚定在原版位置
% （tab 文字基线 y≈6.01pt，pdftotext -bbox 对照原版误差 <0.01pt）。
% 右上角校徽（Figures/xyyg-emblem-names.png，墨迹紧贴画布）以墨迹对齐
% 标题文字：高度 = 当前标题的墨迹高度（\settoheight + \settodepth），
% 顶边锚定在标题墨迹顶线，与标题文字严格同高对齐。
\makeatletter
\newlength{\xyyg@headheight}
\newlength{\xyyg@titleht}
\newlength{\xyyg@titledp}
\newlength{\xyyg@logoheight}
\newlength{\xyyg@logowidth}
\newlength{\xyyg@logoyshift}
% 顶部导航条统一为主题红 xyyg（原继承 palette quaternary，为更暗的红，
% 与底部栏 / 首页标题 box 的纯 xyyg 不一致）
\setbeamercolor{section in head/foot}{bg=xyyg,fg=white} %顶栏中当前section的背景色（校红色）和前景色（白色）
\setbeamercolor{section in head/foot shaded}{bg=xyyg,fg=white!55!xyyg} %非当前section的颜色（55%白色混合校红）
% 条带高度：内容块（tab 文字 + mini-frame 圆点行，约 10.2pt）上下各留 ~1pt 呼吸空间，
% 像素校准为 11.6pt（原版 6ex 在不同字体上下文下求值结果偏大，导致底部空 ~8px）
\AtBeginDocument{\global\xyyg@headheight=11.6pt} %文档开始时设置顶栏高度为11.6pt（像素校准值）
\setbeamertemplate{headline} %自定义顶栏模板
{%
  \begin{beamercolorbox}[wd=\paperwidth,colsep=0pt,ht=\xyyg@headheight,dp=0ex,vmode]{section in head/foot}%
    \vbox to \xyyg@headheight{%
      {\vskip0.52pt}%  % 导航行锚定：像素校准至原版 tab 基线（y=6.01pt，见上方注释）
      \insertnavigation{\paperwidth}%
      \vss}%
  \end{beamercolorbox}%
}
\setbeamertemplate{frametitle}
{%
  \nointerlineskip %标题上方不留额外间距
  \usebeamerfont*{frametitle}%
  \settoheight{\xyyg@titleht}{\insertframetitle}% 测量标题文字的高度
  \settodepth{\xyyg@titledp}{\insertframetitle}% 测量标题文字的深度（下伸部分）
  \xyyg@logoheight=\dimexpr\xyyg@titleht+\xyyg@titledp\relax %校徽高度 = 标题高度 + 标题深度
  %\settowidth{\xyyg@logowidth}{\includegraphics[height=\xyyg@logoheight]{Figures/xyyg-emblem-names.png}}%测量校徽图片的宽度
  \begin{beamercolorbox}[wd=\paperwidth,sep=0.3cm,%
    rightskip=\dimexpr\xyyg@logowidth+0.4cm\relax]{frametitle}%
    \strut\insertframetitle %插入标题文字（用strut保证基线一致）
    \ifx\insertframesubtitle\@empty\else
      \par{\usebeamerfont*{framesubtitle}\usebeamercolor[fg]{framesubtitle}\strut\insertframesubtitle}%如果有副标题，换行显示副标题
    \fi
  \end{beamercolorbox}%
  \nointerlineskip
  \xyyg@logoyshift=\xyyg@headheight
  \addtolength{\xyyg@logoyshift}{0.3cm}%
  \addtolength{\xyyg@logoyshift}{\ht\strutbox}%
  \addtolength{\xyyg@logoyshift}{-\xyyg@titleht}%
  \begin{tikzpicture}[remember picture,overlay] %记住页面坐标，覆盖模式绘制（不占版面空间）
    \node[anchor=north east,inner sep=0pt] %校徽的右上角锚定
      at ([yshift=-\xyyg@logoyshift,xshift=-0.3cm]current page.north east)
      {
      	%\includegraphics[height=\xyyg@logoheight]{Figures/xyyg-emblem-names.png}
      };
  \end{tikzpicture}%
}
\makeatother

% 三线表（booktabs）主题：头尾粗线 1.2pt，中间线 0.5pt，与正文形成明显层次；
% 表头建议用 \textbf 加粗（默认即黑色，不继承任何主题色）。
% booktabs 在 main.tex 中晚于本文件加载，故延迟到导言区末尾设置。
\makeatletter
\AtEndPreamble{\@ifpackageloaded{booktabs}{%导言区末尾才执行（因为booktabs可能在后面才加载） 检查是否加载了booktabs包
  \setlength{\heavyrulewidth}{1.2pt}% 三线表的顶线和底线（粗线）设为1.2pt
  \setlength{\lightrulewidth}{0.5pt}% 表头下方的中线（细线）设为0.5pt
}{}}
\makeatother

